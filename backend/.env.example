# Copia estos nombres de variable a tu configuración de entorno local
# (IntelliJ: Run/Debug Configurations > Environment variables, o `set VAR=valor` antes de mvn)
# y a las variables de entorno de Railway al desplegar. Este archivo es solo documentación,
# Spring Boot no lo lee automáticamente (no hay librería dotenv en el proyecto).

DB_URL=jdbc:mysql://localhost:3306/db_dedea?useSSL=false&serverTimezone=America/Lima&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=root

NEWS_API_KEY=
GEMINI_API_KEY=
ADMIN_SYNC_KEY=

# Genera con: openssl rand -base64 48
JWT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false
